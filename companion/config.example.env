# 复制本文件为 .env 然后填写

# ===== 大脑：DeepSeek =====
DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat 反应快，适合实时聊天；deepseek-reasoner 更聪明但慢，不建议用于通话
DEEPSEEK_MODEL=deepseek-chat

# ===== 她叫什么、怎么称呼你（人设细节在 persona.md 里改）=====
COMPANION_NAME=小雪
USER_NAME=你

# ===== 耳朵：本地语音识别 faster-whisper =====
# 有 N 卡：WHISPER_DEVICE=cuda  WHISPER_MODEL=large-v3  WHISPER_COMPUTE=float16
# 没有 N 卡：WHISPER_DEVICE=cpu  WHISPER_MODEL=small  WHISPER_COMPUTE=int8
WHISPER_DEVICE=auto
WHISPER_MODEL=auto
WHISPER_COMPUTE=auto

# ===== 声音 =====
# edge：免费在线微软语音，开箱即用
# gptsovits：本地 GPT-SoVITS（可克隆任何声音，需另外部署，见 README）
TTS_ENGINE=edge
EDGE_VOICE=zh-CN-XiaoyiNeural
EDGE_RATE=+5%
EDGE_PITCH=+0Hz

GPTSOVITS_URL=http://127.0.0.1:9880/tts
GPTSOVITS_REF_AUDIO=D:/voices/ref.wav
GPTSOVITS_PROMPT_TEXT=参考音频里说的那句话
GPTSOVITS_PROMPT_LANG=zh

# ===== 主动性 =====
# 通话中你沉默多少秒后她会主动找话题（0 = 关闭）
IDLE_SECONDS=60

# 端口
PORT=8765

# ===== 形象 =====
# Live2D 模型的 model3.json 地址。留空用默认示例模型。
# 换自己的模型：把模型文件夹放到 static/models/ 下，然后写 /static/models/文件夹名/xxx.model3.json
LIVE2D_MODEL=

# ===== 真人写实模式（需要 N 卡，见 README 的"真人写实形象"）=====
# live2d = 二次元形象（任何电脑都能跑）；realistic = 真人视频（用 LiveTalking 渲染）
AVATAR_MODE=live2d
LIVETALKING_URL=http://127.0.0.1:8010
# 画面传输：webrtc = 直连 LiveTalking；rtcpush = 经云端 SRS 中转（AutoDL 用这个）
AVATAR_TRANSPORT=webrtc
# rtcpush 时填：http://你的阿里云服务器公网IP:1985/rtc/v1/whep/?app=live&stream=livestream
SRS_WHEP_URL=

# 用哪个人设文件（比如 personas/清冷仙子.md）
PERSONA_FILE=persona.md

# 写实模式下叠加的摄像头噪点强度（0 = 关闭，1 = 正常室内光线，2 = 光线较暗）
CAMERA_GRAIN=1
